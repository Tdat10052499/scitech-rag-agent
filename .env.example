# Copy to .env and fill in real values. NEVER commit .env.

# --- LLM backend (OpenAI-compatible). Switch backends by changing these three lines. ---
# Local Ollama:   http://localhost:11434/v1
# Remote (Colab/Kaggle via tunnel) or hosted API: set the URL provided to you.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=replace-me
LLM_MODEL=replace-me
# Seconds without data from the LLM server before a call fails, and retries after the first try.
# The first call after a new Kaggle session loads the model (74-79 s measured, runbook section 4.1):
# with 60 s that first attempt can time out; the retry then usually finds the model loaded.
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# --- Embeddings ---
# sentence-transformers model of `embed` and of the query embedding (ADR 0007).
EMBEDDING_MODEL=replace-me
# Text put before each query (not before passages) by the dense retriever, joined with one space.
# Empty: none. bge-*-en-v1.5 (ADR 0007): Represent this sentence for searching relevant passages:
EMBEDDING_QUERY_PREFIX=

# --- Vector store ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=scitech_chunks
# Exact vector search (full scan) instead of Qdrant's HNSW graph: true or false. Empty: true.
# At the default HNSW settings one of the 30 dev questions was lost, so dense numbers did not
# match ADR 0007 (#87); exact search costs about 10 ms more per query at 121,926 x 384.
QDRANT_SEARCH_EXACT=true

# --- Retrieval behaviour ---
# Retriever of the agent: dense, bm25 or hybrid (reciprocal rank fusion of both). Empty: hybrid.
RETRIEVER=hybrid
# Directory of the BM25 index (`python -m scitech_agent.retrieval.keyword build`).
# Empty: <DATA_DIR>/index/bm25.
BM25_INDEX_DIR=
# Hybrid only: RRF constant, and how many hits each retriever contributes before fusion.
# Empty: 60, 50 and 50.
RRF_K=
HYBRID_DENSE_TOP_K=
HYBRID_KEYWORD_TOP_K=
RETRIEVAL_TOP_K=5
# Below this score the agent must answer "insufficient evidence". The scale depends on RETRIEVER:
# cosine for dense, BM25 for bm25, RRF (at most 2 / (RRF_K + 1), about 0.033) for hybrid; 0.0
# keeps every hit. A value no hit can reach (above 1 for dense, above 2 / (RRF_K + 1) for
# hybrid) stops the agent at startup. With hybrid, use AGENT_SELF_CHECK instead (ADR 0009).
RETRIEVAL_MIN_SCORE=0.0

# --- Agent behaviour ---
# Rewrite a follow-up message into a standalone search query from the latest turns before
# retrieval (one extra LLM call, only when the session has earlier turns): on or off. Empty: off.
AGENT_REWRITE=on
# Ask the LLM, before answering, whether the retrieved chunks can answer the question (one short
# extra call); NO means the agent refuses with suggestions. An error or unreadable reply lets the
# answer step decide. on or off. Empty: off.
AGENT_SELF_CHECK=off
# Hard limits of one /chat request: LLM calls (rewrite, self-check, answer, follow-ups; at least
# 1, the answer always keeps one) and total seconds (checked between steps and between streamed
# fragments; a single call is bounded by LLM_TIMEOUT). Optional steps are skipped when a limit
# is reached; the answer step fails with `timeout`. Empty: 4 and 120.
AGENT_MAX_LLM_CALLS=4
AGENT_TIMEOUT_S=120
# One JSON line per request (queries, retrieved chunk ids and scores, evidence decision, raw
# and shown answer, LLM calls, latency per step, model and settings; fields in
# docs/runbooks/traces.md). A file path, or off. Empty: <DATA_DIR>/logs/traces.jsonl.
AGENT_TRACES=

# --- Pipelines ---
# Root of the git-ignored data directory (raw/, processed/ ...).
DATA_DIR=data
# User-Agent for the Wikipedia (MediaWiki) API in `download`. Leave empty for the built-in
# project User-Agent; Wikimedia asks for a contact, so a fork should put its own repo URL here.
WIKI_USER_AGENT=
# Spark settings of `clean` (ADR 0005). Empty: local[*] and 4g. Spark needs Java 17+, so
# `clean` runs in WSL2, Linux, Colab or a Kaggle notebook, not natively on Windows.
SPARK_MASTER=
SPARK_DRIVER_MEMORY=
# Chunk length of `chunk` in words, title included, and the overlap between chunks of one
# abstract. Empty: 320 and 48. Set from the embedding model's input limit (ADR 0007).
CHUNK_MAX_WORDS=
CHUNK_OVERLAP_WORDS=

# --- Backend ---
# `POST /feedback` (rating buttons, follow-up clicks): one JSON line per request. A file path, or
# off. Empty: <DATA_DIR>/logs/feedback.jsonl.
FEEDBACK_LOG=
# Agent behind /chat: real (the retriever and LLM configured above) or demo (offline, no index,
# no LLM, for UI work). Empty: real. A real agent that cannot be built (missing LLM settings,
# no BM25 index) is logged at startup and /chat answers with an `error` event.
AGENT_MODE=real
# Comma-separated browser origins allowed to call the API (CORS). Leave empty in development:
# the Vite dev server proxies /health and /chat (ADR 0004). Example: http://localhost:5173
CORS_ORIGINS=

# --- Docker stack (`make up`, docker-compose.yml) ---
# Host port of the UI. Empty: 8080. Inside the stack QDRANT_URL and DATA_DIR are set by
# docker-compose.yml (http://qdrant:6333 and /app/data); the values above are for `make run`.
FRONTEND_PORT=8080
