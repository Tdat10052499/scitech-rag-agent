# Copy to .env and fill in real values. NEVER commit .env.

# --- LLM backend (OpenAI-compatible). Switch backends by changing these three lines. ---
# Local Ollama:   http://localhost:11434/v1
# Remote (Colab/Kaggle via tunnel) or hosted API: set the URL provided to you.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=replace-me
LLM_MODEL=replace-me

# --- Embeddings ---
EMBEDDING_MODEL=replace-me

# --- Vector store ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=scitech_chunks

# --- Retrieval behaviour ---
RETRIEVAL_TOP_K=5
# Below this similarity score the agent must answer "insufficient evidence".
RETRIEVAL_MIN_SCORE=0.0
