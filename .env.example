# Copy to .env and fill in real values. NEVER commit .env.

# --- LLM backend (OpenAI-compatible). Switch backends by changing these three lines. ---
# Local Ollama:   http://localhost:11434/v1
# Remote (Colab/Kaggle via tunnel) or hosted API: set the URL provided to you.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=replace-me
LLM_MODEL=replace-me
# Seconds without data from the LLM server before a call fails, and retries after the first try.
# The first call after a new Kaggle session loads the model (74-79 s measured, runbook section 4.1):
# with 60 s that first attempt can time out; the retry then usually finds the model loaded.
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# --- Embeddings ---
# sentence-transformers model of `embed` and of the query embedding (ADR 0007).
EMBEDDING_MODEL=replace-me

# --- Vector store ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=scitech_chunks

# --- Retrieval behaviour ---
RETRIEVAL_TOP_K=5
# Below this similarity score the agent must answer "insufficient evidence".
RETRIEVAL_MIN_SCORE=0.0

# --- Pipelines ---
# Root of the git-ignored data directory (raw/, processed/ ...).
DATA_DIR=data
# User-Agent for the Wikipedia (MediaWiki) API in `download`. Leave empty for the built-in
# project User-Agent; Wikimedia asks for a contact, so a fork should put its own repo URL here.
WIKI_USER_AGENT=
# Spark settings of `clean` (ADR 0005). Empty: local[*] and 4g. Spark needs Java 17+, so
# `clean` runs in WSL2, Linux, Colab or a Kaggle notebook, not natively on Windows.
SPARK_MASTER=
SPARK_DRIVER_MEMORY=
# Chunk length of `chunk` in words, title included, and the overlap between chunks of one
# abstract. Empty: 320 and 48. Set from the embedding model's input limit (ADR 0007).
CHUNK_MAX_WORDS=
CHUNK_OVERLAP_WORDS=

# --- Backend ---
# Comma-separated browser origins allowed to call the API (CORS). Leave empty in development:
# the Vite dev server proxies /health and /chat (ADR 0004). Example: http://localhost:5173
CORS_ORIGINS=
